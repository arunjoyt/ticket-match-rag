EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/stsb-roberta-base
MATCH_THRESHOLD=0.6221

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=tickets

DATABASE_URL=postgresql://ticket_match:ticket_match@localhost:5432/ticket_match

HELPDESK_URL=http://helpdesk.localhost:8000
HELPDESK_API_KEY=
HELPDESK_API_SECRET=

WEBHOOK_SECRET=
API_KEY=

API_WEBHOOK_URL=http://host.docker.internal:8000/webhook/helpdesk

# Production only (docker-compose.prod.yml) -- bare hostname, no scheme.
# Drives nginx/templates/ticket-match-rag.conf.template.
API_DOMAIN=
